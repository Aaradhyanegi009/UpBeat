# Ignore everything in parent workspace except UpBeat project files
/*
!/.gitignore
!/README.md
!/CHANGELOG.md
!/run.sh
!/.github/
!/android/
!/backend/
!/frontend/
!/macos/
!/electron/
!/api/
!/vercel.json
!/package.json
!/shared/
!/dist.zip
!/dist.zip.sha256

# Build caches & dependencies
frontend/node_modules/
electron/node_modules/
electron/dist-win/
node_modules/
android/.gradle/
android/build/
android/app/build/
android/local.properties
UpBeat-macOS.zip
downloads/
backend/data/downloads/*.m4a
backend/data/downloads/*.part*
**/__pycache__/
**/*.pyc
# Signing keys & secrets (never commit keystores)
*.keystore
*.jks
**/.DS_Store
.DS_Store
